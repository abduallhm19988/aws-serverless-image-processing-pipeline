{
  "Comment": "Illustrative image processing workflow. Replace placeholder ARNs before deployment.",
  "StartAt": "ValidateImage",
  "States": {
    "ValidateImage": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:ValidateImage",
      "TimeoutSeconds": 30,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RecordFailure" }],
      "Next": "ResizeImage"
    },
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:ResizeImage",
      "TimeoutSeconds": 120,
      "Retry": [{ "ErrorEquals": ["Lambda.ServiceException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RecordFailure" }],
      "Next": "ApplyWatermark"
    },
    "ApplyWatermark": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:ApplyWatermark",
      "TimeoutSeconds": 120,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RecordFailure" }],
      "Next": "ExtractMetadata"
    },
    "ExtractMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:ExtractMetadata",
      "TimeoutSeconds": 30,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RecordFailure" }],
      "Next": "FinalizeJob"
    },
    "FinalizeJob": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:FinalizeJob",
      "TimeoutSeconds": 30,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "RecordFailure" }],
      "End": true
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:REGION:ACCOUNT_ID:function:RecordFailure",
      "TimeoutSeconds": 30,
      "End": true
    }
  }
}
